# FundiFix Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/fundifix

# Security
ADMIN_DASHBOARD_KEY=fundifix-admin-local-secure-key
ALLOWED_ORIGINS=http://localhost:3000,https://api.fundifix.com

# mTLS/HTTPS
USE_MTLS=false
# Set to true and ensure backend/certs/server.key, server.crt, ca.crt exist

# Logging
LOG_LEVEL=info
# Options: error, warn, info, http, debug, silly

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS/WhatsApp - Twilio Integration (for production)
# Leave empty to use mock SMS/WhatsApp (development)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
TWILIO_WHATSAPP_PHONE=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
